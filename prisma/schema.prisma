generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users   User[]
  courses Course[]
}

model Course {
  id           String   @id @default(cuid())
  name         String
  departmentId String?
  createdAt    DateTime @default(now())

  department Department?      @relation(fields: [departmentId], references: [id])
  expertises TutorExpertise[]
  requests   TutorRequest[]

  @@index([departmentId])
  @@index([name])
}

model User {
  id           String   @id @default(cuid())
  role         String   @default("STUDENT") // STUDENT, TUTOR, ADMIN
  name         String
  nsuId        String   @unique
  email        String   @unique
  contact      String
  gender       String?
  departmentId String?
  cgpa         Float?
  password     String
  isBlocked      Boolean   @default(false)
  hideCgpa       Boolean   @default(false)
  balance        Float     @default(0)
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())

  department Department? @relation(fields: [departmentId], references: [id])

  expertises       TutorExpertise[]
  studentRequests  TutorRequest[]   @relation("StudentRequests")
  assignedRequests TutorRequest[]   @relation("AssignedRequests")

  consultancyRequests   ConsultancyRequest[]
  refundRequests        RefundRequest[]
  processedRefunds      RefundRequest[] @relation("RefundProcessor")
  passwordResetRequests       PasswordResetRequest[]
  emailVerificationRequests   EmailVerificationRequest[]
  withdrawalRequests    WithdrawalRequest[]
  walletTransactions    WalletTransaction[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]

  @@index([role])
  @@index([departmentId])
  @@index([createdAt])
  @@index([isBlocked])
}

model TutorExpertise {
  id                String   @id @default(cuid())
  tutorId           String
  courseId          String
  semesterCompleted String
  facultyName       String
  courseGrade       String
  availability      String
  sessionFee        Float
  isActive          Boolean  @default(true)
  hideGrade         Boolean  @default(false)
  createdAt         DateTime @default(now())

  tutor  User   @relation(fields: [tutorId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([tutorId])
  @@index([courseId])
  @@index([isActive])
  @@index([createdAt])
}

model TutorRequest {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  topic           String
  facultyName     String?
  preferredMode   String // Online, On Campus
  preferredDateTime String?
  budget          Float
  status          String   @default("PENDING") // PENDING, MATCHED, ACCEPTED, PAYMENT_PENDING, COMPLETED, CANCELLED
  assignedTutorId String?
  rating          Int?
  review          String?
  createdAt       DateTime @default(now())

  student       User   @relation("StudentRequests", fields: [studentId], references: [id])
  assignedTutor User?  @relation("AssignedRequests", fields: [assignedTutorId], references: [id])
  course        Course @relation(fields: [courseId], references: [id])

  payment        Payment?
  refundRequests RefundRequest[]

  @@index([studentId])
  @@index([assignedTutorId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
  @@index([studentId, status])
}

model ConsultancyTopic {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  price       Float    @default(0) // 0 = free, > 0 = paid (debited from wallet at booking)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ConsultancyRequest[]

  @@index([isActive])
}

model ConsultancyRequest {
  id        String   @id @default(cuid())
  studentId String
  topic     String   // Free-text topic — kept for legacy rows + ad-hoc requests
  details   String
  status    String   @default("PENDING") // PENDING, ASSIGNED, COMPLETED, CANCELLED
  // Linked admin-curated topic. Nullable for back-compat with rows created
  // before ConsultancyTopic existed (and for any future ad-hoc requests).
  topicId   String?
  // Snapshot of ConsultancyTopic.price at booking time. Null on legacy/free
  // rows. Stored (not joined) so historical bookings keep their original price
  // even if the topic's price changes later.
  pricePaid Float?
  createdAt DateTime @default(now())

  student User              @relation(fields: [studentId], references: [id])
  consultancyTopic ConsultancyTopic? @relation(fields: [topicId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@index([topicId])
}

model RefundRequest {
  id            String    @id @default(cuid())
  requestId     String
  studentId     String
  details       String
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  // Audit fields — populated when an admin actioned the request.
  amount        Float?    // Session fee credited to wallet on approval (TutorRequest.budget)
  reviewNote    String?   // Optional admin note shown to student + kept on record
  resolvedAt    DateTime? // When the admin approved or rejected
  processedById String?   // Admin who actioned the request
  createdAt     DateTime  @default(now())

  request      TutorRequest @relation(fields: [requestId], references: [id])
  student      User         @relation(fields: [studentId], references: [id])
  processedBy  User?        @relation("RefundProcessor", fields: [processedById], references: [id])

  @@index([requestId])
  @@index([studentId])
  @@index([status])
  @@index([processedById])
}

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  contact   String?
  type      String // REFUND, COMPLAINT, SUGGESTION
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model PasswordResetRequest {
  id        String   @id @default(cuid())
  userId    String
  token     String?
  expiresAt DateTime?
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model EmailVerificationRequest {
  id        String   @id @default(cuid())
  userId    String
  token     String   // 6-digit OTP
  expiresAt DateTime
  status    String   @default("PENDING") // PENDING | RESOLVED | EXPIRED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Holds the registration payload + OTP before the User row is created.
// Keyed by `id` (passed as ?token=… in the verify URL). Consumed on
// successful OTP — the User is then created with emailVerified preset.
model PendingRegistration {
  id             String   @id @default(cuid()) // opaque token in the URL
  email          String   @unique
  nsuId          String   @unique
  name           String
  contact        String
  gender         String?
  departmentId   String?
  cgpa           Float?
  role           String   @default("STUDENT")
  hashedPassword String
  otp            String   // 6-digit code
  expiresAt      DateTime
  status         String   @default("PENDING") // PENDING | RESOLVED | EXPIRED
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([nsuId])
  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id            String   @id @default(cuid())
  requestId     String   @unique
  mfsType       String // BKASH, NAGAD, ROCKET
  accountNumber String
  amount        Float
  transactionId String
  createdAt     DateTime @default(now())

  request TutorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id            String   @id @default(cuid())
  tutorId       String
  amount        Float // Gross amount requested
  platformFee   Float // Platform fee deducted (5%)
  netAmount     Float // Net amount paid (95%)
  method        String   @default("MFS") // MFS or BANK
  // MFS fields (nullable for BANK rows)
  mfsType       String?  // BKASH, NAGAD, ROCKET
  accountNumber String?  // MFS account number
  transferType  String?  // SEND_MONEY, PAYMENT
  // Bank fields (nullable for MFS rows)
  accountHolderName String? // Name as it appears on the bank account
  bankName          String?
  bankAccountNumber String?
  branch            String?
  bftn              String? // Bangladesh Bank Fund Transfer Number
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())

  tutor User @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([status])
  @@index([createdAt])
}

model PaymentInfo {
  id       String   @id @default(cuid())
  data     String   @default("")
  time     DateTime @default(now())

  @@index([time])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VisitorLog {
  id        String   @id @default(cuid())
  ip        String?
  userAgent String?
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float    // Positive for credit/recharge, negative for payment/withdrawal
  type        String   // RECHARGE, TUITION_PAYMENT, EARNING_CREDIT, WITHDRAWAL, REFUND, ADMIN_ADJUSTMENT
  description String
  referenceId String?  // MFS transaction ID or TutorRequest ID
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

