generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  courses   Course[]
}

model Course {
  id           String   @id @default(cuid())
  name         String
  departmentId String?
  createdAt    DateTime @default(now())

  department   Department? @relation(fields: [departmentId], references: [id])
  expertises   TutorExpertise[]
  requests     TutorRequest[]
}

model User {
  id           String   @id @default(cuid())
  role         String   @default("STUDENT") // STUDENT, TUTOR, ADMIN
  name         String
  nsuId        String   @unique
  email        String   @unique
  contact      String
  gender       String?
  departmentId String?
  cgpa         Float?
  password     String
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  department   Department? @relation(fields: [departmentId], references: [id])
  
  expertises       TutorExpertise[]
  studentRequests  TutorRequest[] @relation("StudentRequests")
  assignedRequests TutorRequest[] @relation("AssignedRequests")
  
  consultancyRequests ConsultancyRequest[]
  refundRequests        RefundRequest[]
  passwordResetRequests PasswordResetRequest[]
}

model TutorExpertise {
  id                String   @id @default(cuid())
  tutorId           String
  courseId          String
  semesterCompleted String
  facultyName       String
  courseGrade       String
  availability      String
  sessionFee        Float
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  tutor   User   @relation(fields: [tutorId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])
}

model TutorRequest {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  topic           String
  facultyName     String?
  preferredMode   String // Online, On Campus
  budget          Float
  status          String   @default("PENDING") // PENDING, MATCHED, ACCEPTED, PAYMENT_PENDING, COMPLETED, CANCELLED
  assignedTutorId String?
  createdAt       DateTime @default(now())

  student       User   @relation("StudentRequests", fields: [studentId], references: [id])
  assignedTutor User?  @relation("AssignedRequests", fields: [assignedTutorId], references: [id])
  course        Course @relation(fields: [courseId], references: [id])
  
  refundRequests RefundRequest[]
}

model ConsultancyRequest {
  id        String   @id @default(cuid())
  studentId String
  topic     String
  details   String
  status    String   @default("PENDING") // PENDING, ASSIGNED, COMPLETED
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id])
}

model RefundRequest {
  id        String   @id @default(cuid())
  requestId String
  studentId String
  details   String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())

  request TutorRequest @relation(fields: [requestId], references: [id])
  student User         @relation(fields: [studentId], references: [id])
}

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  contact   String?
  type      String   // REFUND, COMPLAINT, SUGGESTION
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())
}

model PasswordResetRequest {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
