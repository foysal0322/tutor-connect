generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users   User[]
  courses Course[]
}

model Course {
  id           String   @id @default(cuid())
  name         String
  departmentId String?
  createdAt    DateTime @default(now())

  department Department?      @relation(fields: [departmentId], references: [id])
  expertises TutorExpertise[]
  requests   TutorRequest[]

  @@index([departmentId])
  @@index([name])
}

model User {
  id           String   @id @default(cuid())
  role         String   @default("STUDENT") // STUDENT, TUTOR, ADMIN
  name         String
  nsuId        String   @unique
  email        String   @unique
  contact      String
  gender       String?
  departmentId String?
  cgpa         Float?
  password     String
  isBlocked    Boolean  @default(false)
  hideCgpa     Boolean  @default(false)
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id])

  expertises       TutorExpertise[]
  studentRequests  TutorRequest[]   @relation("StudentRequests")
  assignedRequests TutorRequest[]   @relation("AssignedRequests")

  consultancyRequests   ConsultancyRequest[]
  refundRequests        RefundRequest[]
  passwordResetRequests PasswordResetRequest[]
  withdrawalRequests    WithdrawalRequest[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]

  @@index([role])
  @@index([departmentId])
  @@index([createdAt])
  @@index([isBlocked])
}

model TutorExpertise {
  id                String   @id @default(cuid())
  tutorId           String
  courseId          String
  semesterCompleted String
  facultyName       String
  courseGrade       String
  availability      String
  sessionFee        Float
  isActive          Boolean  @default(true)
  hideGrade         Boolean  @default(false)
  createdAt         DateTime @default(now())

  tutor  User   @relation(fields: [tutorId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([tutorId])
  @@index([courseId])
  @@index([isActive])
  @@index([createdAt])
}

model TutorRequest {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  topic           String
  facultyName     String?
  preferredMode   String // Online, On Campus
  preferredDateTime String?
  budget          Float
  status          String   @default("PENDING") // PENDING, MATCHED, ACCEPTED, PAYMENT_PENDING, COMPLETED, CANCELLED
  assignedTutorId String?
  rating          Int?
  review          String?
  createdAt       DateTime @default(now())

  student       User   @relation("StudentRequests", fields: [studentId], references: [id])
  assignedTutor User?  @relation("AssignedRequests", fields: [assignedTutorId], references: [id])
  course        Course @relation(fields: [courseId], references: [id])

  payment        Payment?
  refundRequests RefundRequest[]

  @@index([studentId])
  @@index([assignedTutorId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
  @@index([studentId, status])
}

model ConsultancyRequest {
  id        String   @id @default(cuid())
  studentId String
  topic     String
  details   String
  status    String   @default("PENDING") // PENDING, ASSIGNED, COMPLETED
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
}

model RefundRequest {
  id        String   @id @default(cuid())
  requestId String
  studentId String
  details   String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())

  request TutorRequest @relation(fields: [requestId], references: [id])
  student User         @relation(fields: [studentId], references: [id])

  @@index([requestId])
  @@index([studentId])
  @@index([status])
}

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  contact   String?
  type      String // REFUND, COMPLAINT, SUGGESTION
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model PasswordResetRequest {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Payment {
  id            String   @id @default(cuid())
  requestId     String   @unique
  mfsType       String // BKASH, NAGAD, ROCKET
  accountNumber String
  amount        Float
  transactionId String
  createdAt     DateTime @default(now())

  request TutorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id            String   @id @default(cuid())
  tutorId       String
  amount        Float // Gross amount requested
  platformFee   Float // Platform fee deducted (5%)
  netAmount     Float // Net amount paid (95%)
  mfsType       String // BKASH, NAGAD, ROCKET
  accountNumber String
  transferType  String // SEND_MONEY, PAYMENT
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())

  tutor User @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([status])
  @@index([createdAt])
}

model PaymentInfo {
  id       String   @id @default(cuid())
  provider String
  amount   Float
  sender   String
  trxId    String   @unique
  time     DateTime @default(now())

  @@index([time])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
