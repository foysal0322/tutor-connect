generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users   User[]
  courses Course[]
}

model Course {
  id           String   @id @default(cuid())
  name         String
  departmentId String?
  createdAt    DateTime @default(now())

  department Department?      @relation(fields: [departmentId], references: [id])
  expertises TutorExpertise[]
  requests   TutorRequest[]

  @@index([departmentId])
  @@index([name])
}

model User {
  id            String    @id @default(cuid())
  role          String    @default("STUDENT") // STUDENT, TUTOR, ADMIN
  name          String
  nsuId         String    @unique
  email         String    @unique
  contact       String
  gender        String?
  departmentId  String?
  cgpa          Float?
  password      String
  isBlocked     Boolean   @default(false)
  hideCgpa      Boolean   @default(false)
  balance       Float     @default(0)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  department        Department?        @relation(fields: [departmentId], references: [id])
  couponRedemptions CouponRedemption[]

  expertises       TutorExpertise[]
  studentRequests  TutorRequest[]   @relation("StudentRequests")
  assignedRequests TutorRequest[]   @relation("AssignedRequests")

  consultancyRequests       ConsultancyRequest[]
  refundRequests            RefundRequest[]
  processedRefunds          RefundRequest[]            @relation("RefundProcessor")
  passwordResetRequests     PasswordResetRequest[]
  emailVerificationRequests EmailVerificationRequest[]
  withdrawalRequests        WithdrawalRequest[]
  walletTransactions        WalletTransaction[]
  notifications             Notification[]
  pushSubscriptions         PushSubscription[]
  notificationPreferences   NotificationPreference[]

  // NSUOne Shop — additive back-relations. See NSUONE_SHOP_BLUEPRINT.md.
  // Capability is data-derived from ShopSellerProfile/ShopListing rows, NOT
  // from a new role or a flag on User. The unified-campus model is preserved.
  shopListings        ShopListing[]      @relation("ShopSellerListings")
  shopBuyerOrders     ShopOrder[]        @relation("ShopBuyerOrders")
  shopSellerOrders    ShopOrder[]        @relation("ShopSellerOrders")
  shopReviewsGiven    ShopReview[]       @relation("ShopReviewsGiven")
  shopReviewsReceived ShopReview[]       @relation("ShopReviewsReceived")
  shopSaves           ShopSavedListing[] @relation("ShopSavedBy")
  shopReportsFiled    ShopReport[]       @relation("ShopReportsFiled")
  shopDisputesOpened  ShopDispute[]      @relation("ShopDisputesOpened")
  shopSellerProfile   ShopSellerProfile?

  @@index([role])
  @@index([departmentId])
  @@index([createdAt])
  @@index([isBlocked])
}

model TutorExpertise {
  id                String   @id @default(cuid())
  tutorId           String
  courseId          String
  semesterCompleted String
  facultyName       String
  courseGrade       String
  availability      String
  sessionFee        Float
  isActive          Boolean  @default(true)
  hideGrade         Boolean  @default(false)
  createdAt         DateTime @default(now())

  tutor  User   @relation(fields: [tutorId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([tutorId])
  @@index([courseId])
  @@index([isActive])
  @@index([createdAt])
}

model TutorRequest {
  id                String   @id @default(cuid())
  studentId         String
  courseId          String
  topic             String
  facultyName       String?
  preferredMode     String // Online, On Campus
  preferredDateTime String?
  budget            Float
  status            String   @default("PENDING") // PENDING, MATCHED, ACCEPTED, PAYMENT_PENDING, COMPLETED, CANCELLED
  assignedTutorId   String?
  rating            Int?
  review            String?
  createdAt         DateTime @default(now())

  student       User   @relation("StudentRequests", fields: [studentId], references: [id])
  assignedTutor User?  @relation("AssignedRequests", fields: [assignedTutorId], references: [id])
  course        Course @relation(fields: [courseId], references: [id])

  payment        Payment?
  refundRequests RefundRequest[]

  @@index([studentId])
  @@index([assignedTutorId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
  @@index([studentId, status])
}

model ConsultancyTopic {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  price       Float    @default(0) // 0 = free, > 0 = paid (debited from wallet at booking)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ConsultancyRequest[]

  @@index([isActive])
}

model ConsultancyRequest {
  id        String   @id @default(cuid())
  studentId String
  topic     String // Free-text topic — kept for legacy rows + ad-hoc requests
  details   String
  status    String   @default("PENDING") // PENDING, ASSIGNED, COMPLETED, CANCELLED
  // Linked admin-curated topic. Nullable for back-compat with rows created
  // before ConsultancyTopic existed (and for any future ad-hoc requests).
  topicId   String?
  // Snapshot of ConsultancyTopic.price at booking time. Null on legacy/free
  // rows. Stored (not joined) so historical bookings keep their original price
  // even if the topic's price changes later.
  pricePaid Float?
  createdAt DateTime @default(now())

  student          User              @relation(fields: [studentId], references: [id])
  consultancyTopic ConsultancyTopic? @relation(fields: [topicId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@index([topicId])
}

model RefundRequest {
  id            String    @id @default(cuid())
  requestId     String
  studentId     String
  details       String
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  // Audit fields — populated when an admin actioned the request.
  amount        Float? // Session fee credited to wallet on approval (TutorRequest.budget)
  reviewNote    String? // Optional admin note shown to student + kept on record
  resolvedAt    DateTime? // When the admin approved or rejected
  processedById String? // Admin who actioned the request
  createdAt     DateTime  @default(now())

  request     TutorRequest @relation(fields: [requestId], references: [id])
  student     User         @relation(fields: [studentId], references: [id])
  processedBy User?        @relation("RefundProcessor", fields: [processedById], references: [id])

  @@index([requestId])
  @@index([studentId])
  @@index([status])
  @@index([processedById])
}

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  contact   String?
  type      String // REFUND, COMPLAINT, SUGGESTION
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model PasswordResetRequest {
  id        String    @id @default(cuid())
  userId    String
  token     String?
  expiresAt DateTime?
  status    String    @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model EmailVerificationRequest {
  id        String   @id @default(cuid())
  userId    String
  token     String // 6-digit OTP
  expiresAt DateTime
  status    String   @default("PENDING") // PENDING | RESOLVED | EXPIRED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Holds the registration payload + OTP before the User row is created.
// Keyed by `id` (passed as ?token=… in the verify URL). Consumed on
// successful OTP — the User is then created with emailVerified preset.
model PendingRegistration {
  id             String   @id @default(cuid()) // opaque token in the URL
  email          String   @unique
  nsuId          String   @unique
  name           String
  contact        String
  gender         String?
  departmentId   String?
  cgpa           Float?
  role           String   @default("STUDENT")
  hashedPassword String
  otp            String // 6-digit code
  expiresAt      DateTime
  status         String   @default("PENDING") // PENDING | RESOLVED | EXPIRED
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([nsuId])
  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id            String   @id @default(cuid())
  requestId     String   @unique
  mfsType       String // BKASH, NAGAD, ROCKET
  accountNumber String
  amount        Float
  transactionId String
  createdAt     DateTime @default(now())

  request TutorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id                String   @id @default(cuid())
  tutorId           String
  amount            Float // Gross amount requested
  platformFee       Float // Platform fee deducted (5%)
  netAmount         Float // Net amount paid (95%)
  method            String   @default("MFS") // MFS or BANK
  // MFS fields (nullable for BANK rows)
  mfsType           String? // BKASH, NAGAD, ROCKET
  accountNumber     String? // MFS account number
  transferType      String? // SEND_MONEY, PAYMENT
  // Bank fields (nullable for MFS rows)
  accountHolderName String? // Name as it appears on the bank account
  bankName          String?
  bankAccountNumber String?
  branch            String?
  bftn              String? // Bangladesh Bank Fund Transfer Number
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt         DateTime @default(now())

  tutor User @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([status])
  @@index([createdAt])
}

model PaymentInfo {
  id   String   @id @default(cuid())
  data String   @default("")
  time DateTime @default(now())

  @@index([time])
}

// Notification system — see NOTIFICATION_SYSTEM_ARCHITECTURE_BLUEPRINT.md §IX.
// All columns added in Phase 2 are additive with safe defaults so existing
// rows backfill automatically and every existing query keeps working.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Phase 2 additive columns — defaults backfill existing rows.
  type              String    @default("SYSTEM") // NotificationType enum value
  category          String    @default("SYSTEM") // NotificationCategory enum value
  priority          String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  archived          Boolean   @default(false)
  readAt            DateTime?
  expiresAt         DateTime?
  metadata          Json?
  dedupKey          String?
  actorUserId       String? // who caused it (loose ref — no FK to avoid cascade surprises)
  recipientRoleHint String? // STUDENT | TUTOR | ADMIN (for dual-role UI filtering)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, archived, createdAt(sort: Desc)])
  @@index([dedupKey, createdAt])
  @@index([expiresAt])
}

// Per-notification per-channel delivery log. Written by the channel providers
// (Phase 4). Today's direct createNotification path does not populate rows;
// that is intentional and changes nothing about current behavior.
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String
  channel        String // IN_APP | EMAIL | PUSH | DISCORD | SMS | WEBHOOK
  status         String    @default("PENDING") // PENDING | SENT | FAILED | EXPIRED
  attempts       Int       @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel, status])
  @@index([status])
}

// Per-user per-category channel matrix. Absence of a row means "all channels
// on" — i.e. current behavior. CRITICAL priority events bypass preferences
// (see blueprint §XVI invariant #10).
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String
  category     String // NotificationCategory value
  channelInApp Boolean  @default(true)
  channelEmail Boolean  @default(true)
  channelPush  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VisitorLog {
  id        String   @id @default(cuid())
  ip        String?
  userAgent String?
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float // Positive for credit/recharge, negative for payment/withdrawal
  type        String // RECHARGE, TUITION_PAYMENT, EARNING_CREDIT, WITHDRAWAL, REFUND, ADMIN_ADJUSTMENT, CONSULTANCY_PAYMENT
  description String
  referenceId String? // MFS transaction ID or TutorRequest ID
  // COMPLETED for system-generated txns. Member MFS deposits start PENDING
  // (no balance credit yet) and move to APPROVED (credited) or REJECTED by
  // an admin after TrxID verification.
  status      String   @default("COMPLETED") // COMPLETED | PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// Singleton configuration row. App reads the row whose id = 'default'.
// Seed happens lazily on first getPlatformSettings() call.
model PlatformSetting {
  id                             String   @id
  withdrawalFeePercent           Float    @default(5) // tutor-side withdrawal commission, %
  paymentFeePercent              Float    @default(10) // student-side payment fee, %
  promoDiscountPercent           Float    @default(50) // promo applied on paymentFeePercent, %
  consultancyFreeQuota           Int      @default(2) // free consultancy sessions per student
  consultancyPaidSessionPrice    Float    @default(100) // BDT charged per session after the free quota is exhausted
  // NSUOne Shop fields (additive — safe defaults, no behaviour change for
  // existing transactions). See NSUONE_SHOP_BLUEPRINT.md §3.5, §8.
  shopCommissionRateDefault      Float    @default(0.07) // 0–0.20, captured per-order at sale time
  shopAutoFinalizeHours          Int      @default(72)
  shopDisputeWindowHours         Int      @default(48)
  shopListingMaxImages           Int      @default(6)
  shopBoostFeeBdt                Float    @default(100)
  shopBoostDays                  Int      @default(7)
  shopModerationMode             String   @default("AUTO") // AUTO | MANUAL
  shopMinPriceBdt                Float    @default(20)
  shopMaxPriceBdt                Float    @default(50000)
  shopMaxActiveListingsPerSeller Int      @default(50)
  updatedAt                      DateTime @updatedAt
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  scope        String // COMMISSION | TUITION | CONSULTANCY
  discountType String // PERCENT | FLAT
  value        Float // percent (0-100) for PERCENT, BDT amount for FLAT
  minAmount    Float     @default(0) // minimum base amount required to apply
  maxDiscount  Float? // cap for PERCENT; null = uncapped
  usageLimit   Int? // null = unlimited
  usedCount    Int       @default(0)
  validFrom    DateTime  @default(now())
  validUntil   DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  redemptions CouponRedemption[]

  @@index([scope])
  @@index([isActive])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  reference String? // e.g. WithdrawalRequest.id / TutorRequest.id / ConsultancyRequest.id
  discount  Float // snapshot of the discount amount applied (BDT)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, reference])
  @@index([couponId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// NSUOne Shop — peer-to-peer campus marketplace.
//
// Fully additive module. See NSUONE_SHOP_BLUEPRINT.md for the architecture
// and the regression contract. Everything here is isolated from existing
// auth/tutor/payment/consultancy logic; the only existing models touched are
// the optional back-relations added to `User` above and the shop fields
// appended to `PlatformSetting`.
//
// Conventions (match existing schema):
//   - All "enums" are plain String fields with comments listing the values.
//     No Prisma `enum` blocks (none exist in this schema).
//   - Money is Float (BDT). Matches WalletTransaction.amount, User.balance,
//     WithdrawalRequest.amount, etc. Decimal was considered and rejected to
//     keep ledger style uniform.
// ---------------------------------------------------------------------------

model ShopCategory {
  id                     String   @id @default(cuid())
  slug                   String   @unique // "books", "calculators", "lab-kits", ...
  name                   String
  description            String?
  icon                   String? // lucide icon name
  commissionRateOverride Float? // null = use PlatformSetting.shopCommissionRateDefault
  sortOrder              Int      @default(0)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  listings ShopListing[]

  @@index([isActive, sortOrder])
}

model ShopListing {
  id           String    @id @default(cuid())
  sellerId     String
  categoryId   String
  title        String
  description  String
  condition    String    @default("GOOD") // NEW | LIKE_NEW | GOOD | FAIR | FOR_PARTS
  priceBdt     Float
  quantity     Int       @default(1)
  status       String    @default("DRAFT") // DRAFT | PENDING_REVIEW | ACTIVE | PAUSED | SOLD | EXPIRED | REJECTED | REMOVED
  location     String? // free text — "NSU Campus", "Library", etc.
  images       Json      @default("[]") // [{id,url,sortOrder}]
  viewCount    Int       @default(0)
  savedCount   Int       @default(0)
  soldCount    Int       @default(0)
  boostedUntil DateTime? // Phase 9 (optional Boost)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  seller   User               @relation("ShopSellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  category ShopCategory       @relation(fields: [categoryId], references: [id])
  saves    ShopSavedListing[]
  reviews  ShopReview[]
  orders   ShopOrder[]
  reports  ShopReport[]
  boosts   ShopBoost[]

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([sellerId, status])
  @@index([createdAt])
  @@index([title])
  @@index([boostedUntil])
}

model ShopOrder {
  id                  String    @id @default(cuid())
  buyerId             String
  sellerId            String
  listingId           String
  listingSnapshot     Json // title, price, condition, images at purchase
  quantity            Int
  unitPriceBdt        Float
  subtotalBdt         Float // quantity * unitPriceBdt
  commissionRate      Float // captured rate at sale time (0–1)
  commissionBdt       Float
  payoutBdt           Float // subtotal - commission
  escrowTxId          String? // WalletTransaction.id (debit from buyer)
  payoutTxId          String? // WalletTransaction.id (credit to seller)
  commissionTxId      String? // WalletTransaction.id (platform revenue)
  refundTxId          String? // WalletTransaction.id (if refunded)
  status              String    @default("ESCROWED") // AWAITING_CONFIRMATION | ESCROWED | SHIPPED | DELIVERED | COMPLETED | DISPUTED | REFUNDED | CANCELLED
  shipProof           Json? // [{kind:"PROOF_OF_DELIVERY", url}]
  shippedAt           DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  disputeWindowEndsAt DateTime?
  autoFinalizeAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  buyer   User             @relation("ShopBuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User             @relation("ShopSellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  listing ShopListing      @relation(fields: [listingId], references: [id])
  events  ShopOrderEvent[]
  dispute ShopDispute?
  review  ShopReview?

  @@index([buyerId, status, createdAt(sort: Desc)])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([status, autoFinalizeAt])
  @@index([status, disputeWindowEndsAt])
}

model ShopOrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String // CREATED | PAID | SHIPPED | DELIVERED | COMPLETED | DISPUTE_OPENED | DISPUTE_MESSAGE | DISPUTE_RESOLVED | REFUNDED | CANCELLED | COMMISSION_CAPTURED | PAYOUT_RELEASED
  actorId   String?
  metadata  Json?
  note      String?
  createdAt DateTime @default(now())

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ShopDispute {
  id           String    @id @default(cuid())
  orderId      String    @unique
  openedById   String
  reason       String
  status       String    @default("OPEN") // OPEN | AWAITING_SELLER | AWAITING_BUYER | RESOLVED_BUYER | RESOLVED_SELLER | ESCALATED | CLOSED
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order    ShopOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages ShopDisputeMessage[]
  openedBy User                 @relation("ShopDisputesOpened", fields: [openedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
}

model ShopDisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  authorId    String
  body        String
  attachments Json?
  createdAt   DateTime @default(now())

  dispute ShopDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
}

model ShopReview {
  id         String   @id @default(cuid())
  orderId    String   @unique
  fromUserId String
  toUserId   String
  listingId  String
  rating     Int // 1–5
  body       String?
  createdAt  DateTime @default(now())

  from    User        @relation("ShopReviewsGiven", fields: [fromUserId], references: [id])
  to      User        @relation("ShopReviewsReceived", fields: [toUserId], references: [id])
  listing ShopListing @relation(fields: [listingId], references: [id])
  order   ShopOrder   @relation(fields: [orderId], references: [id])

  @@index([toUserId, createdAt(sort: Desc)])
  @@index([listingId])
}

model ShopSavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User        @relation("ShopSavedBy", fields: [userId], references: [id], onDelete: Cascade)
  listing ShopListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
}

model ShopReport {
  id          String   @id @default(cuid())
  listingId   String?
  reporterId  String
  reason      String // PROHIBITED_ITEM | MISREPRESENTATION | SPAM | FRAUD | OFF_CAMPUS_TRANSACTION_REQUEST | HARASSMENT | OTHER
  detail      String?
  status      String   @default("OPEN") // OPEN | ACKNOWLEDGED | ACTIONED | DISMISSED
  handledById String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing  ShopListing? @relation(fields: [listingId], references: [id])
  reporter User         @relation("ShopReportsFiled", fields: [reporterId], references: [id])

  @@index([status, createdAt(sort: Desc)])
}

// 1:1 with User. Lazily created on the user's first listing attempt.
// Holds denormalized seller stats so the storefront + admin views avoid
// real-time aggregates on hot paths.
model ShopSellerProfile {
  userId         String   @id
  bio            String?
  storefrontName String?
  isSuspended    Boolean  @default(false)
  listingCount   Int      @default(0)
  completedSales Int      @default(0)
  avgRating      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isSuspended, completedSales(sort: Desc)])
}

// Image metadata for listings, delivery proof, and dispute evidence.
// (Upload pipeline lands in Phase 5 — until then listings store image URLs
// inline in ShopListing.images JSON. This model is here so the Phase 5
// migration is no-op schema-wise.)
model ShopImage {
  id         String   @id @default(cuid())
  kind       String   @default("LISTING") // LISTING | PROOF_OF_DELIVERY | DISPUTE_EVIDENCE
  listingId  String?
  orderId    String?
  uploaderId String
  url        String
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@index([orderId])
}

// Phase 9 (optional Boost). Model exists so the schema is stable from day
// one; not exercised until Phase 9 ships.
model ShopBoost {
  id        String   @id @default(cuid())
  listingId String
  paidTxId  String // WalletTransaction.id
  startsAt  DateTime @default(now())
  endsAt    DateTime
  feeBdt    Float
  createdAt DateTime @default(now())

  listing ShopListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([endsAt])
}
